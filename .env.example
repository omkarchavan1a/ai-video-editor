# LLM — Nvidia Build (OpenAI-compatible) is primary.
# Get a key at https://build.nvidia.com (format: nvapi-...)
LLM_API_KEY=
# Optional override. Defaults to Nvidia endpoint.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct
#
# The key you pasted (mstrl_...) is a Mistral AI key, not Nvidia.
# It works too: set LLM_BASE_URL=https://api.mistral.ai/v1
# and LLM_MODEL=mistral-large-latest
#
# Optional STT (else browser on-device + sample transcript is used):
# OPENAI_API_KEY=
# GROQ_API_KEY=
